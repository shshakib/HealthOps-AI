# Optional overrides. Defaults in compose.yaml work for local synthetic data.
HEALTHOPS_PORT=18000
FHIR_PORT=8080
FHIR_DB_PASSWORD=healthops-local-only

# Optional: exact name of an already downloaded LOCAL Ollama model supporting tools.
# Leave blank for the evidence-only assistant; there are no paid API calls.
HEALTHOPS_OLLAMA_MODEL=
# For Python development only; Compose uses host.docker.internal automatically.
HEALTHOPS_OLLAMA_URL=http://127.0.0.1:11434

# Optional persistent server defaults. Leave blank to use dashboard session settings.
# Provider: offline, ollama, openai, anthropic, or gemini.
HEALTHOPS_AI_PROVIDER=
HEALTHOPS_OPENAI_MODEL=
HEALTHOPS_ANTHROPIC_MODEL=
HEALTHOPS_GEMINI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
